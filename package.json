{
  "name": "hyeameha-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/enforce-pnpm.mjs",
    "postinstall": "node scripts/enforce-pnpm.mjs",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "docker compose up -d hyeameha-db hyeameha-redis && nest start --watch",
    "docker:up": "docker compose up -d hyeameha-db hyeameha-redis",
    "docker:up:all": "docker compose up -d",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "migration:generate": "TYPEORM_MIGRATIONS_ONLY=1 TS_NODE_TRANSPILE_ONLY=true node ./node_modules/typeorm/cli-ts-node-commonjs.js -d src/database/data-source.ts migration:generate src/database/migrations/AutoMigration",
    "migration:run": "TYPEORM_MIGRATIONS_ONLY=1 TS_NODE_TRANSPILE_ONLY=true node ./node_modules/typeorm/cli-ts-node-commonjs.js -d src/database/data-source.ts migration:run",
    "migration:run:prod": "node ./node_modules/typeorm/cli.js -d dist/database/data-source.js migration:run",
    "migration:revert": "TYPEORM_MIGRATIONS_ONLY=1 TS_NODE_TRANSPILE_ONLY=true node ./node_modules/typeorm/cli-ts-node-commonjs.js -d src/database/data-source.ts migration:revert",
    "seed": "TS_NODE_TRANSPILE_ONLY=true ts-node -r tsconfig-paths/register src/database/seed.ts",
    "seed:force": "TS_NODE_TRANSPILE_ONLY=true ts-node -r tsconfig-paths/register src/database/seed.ts -- --force",
    "test": "jest --watchman=false",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --watchman=false",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --watchman=false",
    "prepare": "husky",
    "knip": "knip"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.2.11",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.11",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.8.0",
    "@nestjs/typeorm": "^11.0.3",
    "axios": "^1.21.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.6.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "joi": "^18.3.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.11",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.16.22",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "knip": "^6.48.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0"
  },
  "lint-staged": {
    "{src,test}/**/*.ts": "eslint --fix"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.spec.ts",
      "!main.ts",
      "!app.module.ts",
      "!**/*.module.ts",
      "!**/dto/**",
      "!**/entities/**",
      "!**/migrations/**",
      "!**/data-source.ts",
      "!**/*.d.ts",
      "!**/*types.ts",
      "!**/*.interface.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 60,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
